<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat A4 Landscape untuk Sertifikat -->
    <record id="paperformat_hcdi_certificate_a4" model="report.paperformat">
        <field name="name">HCDI Certificate A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- Action Report PDF -->
    <record id="action_report_hcdi_certificate" model="ir.actions.report">
        <field name="name">Sertifikat Kelulusan HCDI</field>
        <field name="model">hcdi.training.history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hcdi_training.report_hcdi_certificate_document</field>
        <field name="report_file">hcdi_training.report_hcdi_certificate_document</field>
        <field name="paperformat_id" ref="paperformat_hcdi_certificate_a4"/>
        <field name="print_report_name">'Sertifikat - %s - %s' % (object.employee_id.name, object.channel_id.name)</field>
        <field name="binding_model_id" ref="model_hcdi_training_history"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Note: Sertifikat PDF utama digenerate secara presisi via Python ReportLab di training_history.py -->
    <template id="report_hcdi_certificate_document">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="text-align: center; padding-top: 50px;">
                    <h2>Sertifikat Kelulusan HCDI</h2>
                    <p>Peserta: <t t-esc="o.employee_id.name"/></p>
                    <p>Pelatihan: <t t-esc="o.channel_id.name"/></p>
                    <p>Nomor Sertifikat: <t t-esc="o.certificate_number"/></p>
                </div>
            </t>
        </t>
    </template>
</odoo>
