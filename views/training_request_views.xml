<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View for Training Request -->
    <record id="view_hcdi_training_request_tree" model="ir.ui.view">
        <field name="name">hcdi.training.request.list</field>
        <field name="model">hcdi.training.request</field>
        <field name="arch" type="xml">
            <list string="Training Request (Approval)">
                <field name="name"/>
                <field name="manager_id"/>
                <field name="department_id"/>
                <field name="estimated_date"/>
                <field name="trainer_id"/>
                <field name="approval_state" widget="badge"
                       decoration-success="approval_state == 'approved'"
                       decoration-danger="approval_state == 'reject'"
                       decoration-warning="approval_state == 'waiting'"
                       decoration-info="approval_state == 'draft'"/>
                <field name="course_id"/>
            </list>
        </field>
    </record>

    <!-- Form View for Training Request -->
    <record id="view_hcdi_training_request_form" model="ir.ui.view">
        <field name="name">hcdi.training.request.form</field>
        <field name="model">hcdi.training.request</field>
        <field name="arch" type="xml">
            <form string="Training Request (Approval)">
                <header>
                    <field name="show_approve" invisible="1"/>
                    <button name="action_submit_for_approval"
                            type="object"
                            string="Send Approval"
                            class="btn-primary"
                            invisible="approval_state in ['waiting', 'approved', 'reject']"/>

                    <button name="action_approve_request"
                            type="object"
                            string="Approve"
                            class="btn-primary"
                            invisible="not show_approve or approval_state != 'waiting'"/>

                    <button name="action_reject_request"
                            type="object"
                            string="Reject"
                            class="btn-secondary"
                            invisible="not show_approve or approval_state != 'waiting'"/>

                    <button name="action_create_course"
                            type="object"
                            string="Create eLearning Course"
                            class="btn-primary"
                            invisible="approval_state != 'approved' or course_id"/>
                    
                    <field name="approval_state" widget="statusbar" statusbar_visible="draft,waiting,approved,reject"/>
                </header>
                 <sheet>
                    <div class="oe_title">
                        <label for="name" string="Training Request Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Data Analytics &amp; Python Training Request"/>
                        </h1>
                    </div>
                    <group>
                        <group string="1. Approval Information">
                            <field name="manager_id"/>
                            <field name="department_id"/>
                            <field name="estimated_date"/>
                        </group>
                        <group string="2. HR L&amp;D Approval Workflow">
                            <field name="approval_team_id" required="1"/>
                            <field name="approval_id" readonly="1"/>
                            <field name="course_id" readonly="1"/>
                        </group>
                    </group>

                    <!-- Section Khusus Penetapan HR L&D setelah Approved -->
                    <group string="3. Trainer Assignment" invisible="approval_state != 'approved'">
                        <field name="trainer_id" placeholder="Select Trainer / Instructor..."/>
                    </group>

                    <notebook>
                        <page string="Training Needs &amp; Rationale (TNA)" name="reason_page">
                            <field name="reason" placeholder="Describe the training needs or rationale..."/>
                        </page>
                        <page string="Training Participants" name="participants_page">
                            <field name="target_participant_ids">
                                <list string="Participants List">
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="job_id"/>
                                    <field name="work_email"/>
                                </list>
                            </field>
                        </page>
                        <page string="File Attachment" name="attachments_page">
                            <field name="attachment_ids" widget="many2many_binary" string="Upload Document / Proof Files"/>
                        </page>
                        <page string="Approval Steps &amp; Status" name="approval_steps_page" invisible="not approval_id">
                            <field name="approval_step_ids" readonly="1">
                                <list string="Approval Steps">
                                    <field name="steps" string="Step #"/>
                                    <field name="approver_id" string="Approver"/>
                                    <field name="role" string="Role / Position"/>
                                    <field name="current_state" widget="badge"
                                           decoration-success="current_state == 'approved'"
                                           decoration-danger="current_state == 'reject'"
                                           decoration-warning="current_state == 'pending'"/>
                                    <field name="note" string="Approval Note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action Window for Training Request -->
    <record id="action_hcdi_training_request" model="ir.actions.act_window">
        <field name="name">TNA Request</field>
        <field name="res_model">hcdi.training.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No training requests found. Click 'New' to create a new request.
            </p>
        </field>
    </record>

    <!-- Menuitem for Training Request -->
    <menuitem id="menu_hcdi_training_request_list"
              name="TNA Request"
              parent="menu_hcdi_training_root"
              action="action_hcdi_training_request"
              sequence="10"/>
</odoo>
