<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View for Progres Training (create="0" -> no manual creation) -->
    <record id="view_hcdi_training_progress_tree" model="ir.ui.view">
        <field name="name">hcdi.training.progress.list</field>
        <field name="model">hcdi.training.history</field>
        <field name="arch" type="xml">
            <list string="Progres Training Karyawan" create="0">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="channel_id"/>
                <field name="trainer_id"/>
                <field name="start_date"/>
                <field name="completion_date"/>
                <field name="execution_state" widget="badge"
                       decoration-info="execution_state == 'draft'"
                       decoration-warning="execution_state == 'in_progress'"
                       decoration-success="execution_state == 'done'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'passed'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- List View for Training History (Completed Records) -->
    <record id="view_hcdi_training_history_tree" model="ir.ui.view">
        <field name="name">hcdi.training.history.list</field>
        <field name="model">hcdi.training.history</field>
        <field name="arch" type="xml">
            <list string="Riwayat Training Karyawan" create="0">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="channel_id"/>
                <field name="trainer_id"/>
                <field name="completion_date"/>
                <field name="score_pretest"/>
                <field name="score_quiz"/>
                <field name="score_posttest"/>
                <field name="final_score"/>
                <field name="passing_grade"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'passed'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'draft'"/>
                <field name="certificate_number"/>
            </list>
        </field>
    </record>

    <!-- Form View for Training History & Progress -->
    <record id="view_hcdi_training_history_form" model="ir.ui.view">
        <field name="name">hcdi.training.history.form</field>
        <field name="model">hcdi.training.history</field>
        <field name="arch" type="xml">
            <form string="Detail Progres &amp; Riwayat Training">
                <header>
                    <button name="action_start_training"
                            type="object"
                            string="Mulai Training"
                            class="btn-primary"
                            invisible="execution_state != 'draft'"/>

                    <button name="action_complete_training"
                            type="object"
                            string="Selesaikan Training (Done)"
                            class="btn-success"
                            invisible="execution_state != 'in_progress'"/>

                    <button name="action_generate_certificate"
                            type="object"
                            string="Cetak &amp; Kirim Sertifikat"
                            class="btn-info"
                            invisible="state != 'passed'"/>
                    
                    <field name="execution_state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" placeholder="Pilih Karyawan..."/>
                        </h1>
                        <h3>
                            <field name="channel_id" placeholder="Pilih Course Training..."/>
                        </h3>
                    </div>
                    <group>
                        <group string="Informasi Pelaksanaan">
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="trainer_id"/>
                            <field name="start_date"/>
                            <field name="completion_date"/>
                            <field name="execution_state" readonly="1"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'passed'"
                                   decoration-danger="state == 'failed'"
                                   decoration-info="state == 'draft'"/>
                        </group>
                        <group string="Hasil Evaluasi &amp; Nilai Ujian">
                            <field name="score_pretest" readonly="1" force_save="1"/>
                            <field name="score_quiz" readonly="1" force_save="1"/>
                            <field name="score_posttest" readonly="1" force_save="1"/>
                            <field name="final_score" class="oe_subtotal_footer_separator"/>
                            <field name="passing_grade"/>
                        </group>
                    </group>
                    <group string="Informasi Sertifikat" invisible="state != 'passed'">
                        <field name="certificate_number"/>
                        <field name="certificate_file" filename="certificate_filename"/>
                        <field name="certificate_filename" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action Window for Submenu 1: Progres Training -->
    <record id="action_hcdi_training_progress" model="ir.actions.act_window">
        <field name="name">Progres Training</field>
        <field name="res_model">hcdi.training.history</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hcdi_training_progress_tree"/>
        <field name="domain">[('execution_state', 'in', ['draft', 'in_progress', 'done'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data progres training. Peserta otomatis ditarik dari Pengajuan Training yang telah disetujui.
            </p>
        </field>
    </record>

    <!-- Action Window for Submenu 2: Riwayat Training (Done Records Only) -->
    <record id="action_hcdi_training_history" model="ir.actions.act_window">
        <field name="name">Riwayat Training</field>
        <field name="res_model">hcdi.training.history</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hcdi_training_history_tree"/>
        <field name="domain">[('execution_state', '=', 'done')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data riwayat training yang selesai (Done).
            </p>
        </field>
    </record>

    <!-- Submenu 1: Progres Training -->
    <menuitem id="menu_hcdi_training_progress_list"
              name="Progres Training"
              parent="menu_hcdi_training_reporting"
              action="action_hcdi_training_progress"
              sequence="15"/>

    <!-- Submenu 2: Riwayat Training (Menggunakan yang lama & diperbarui) -->
    <menuitem id="menu_hcdi_training_history_list"
              name="Riwayat Training"
              parent="menu_hcdi_training_reporting"
              action="action_hcdi_training_history"
              sequence="20"/>
</odoo>
