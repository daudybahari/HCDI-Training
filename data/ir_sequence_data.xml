<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence Numbering untuk Sertifikat HCDI -->
    <record id="seq_hcdi_training_certificate" model="ir.sequence">
        <field name="name">HCDI Training Certificate Sequence</field>
        <field name="code">hcdi.training.certificate</field>
        <field name="prefix">CERT/HCDI/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
